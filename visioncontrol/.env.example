OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=10
OPENAI_ENABLED=true
AI_MODE=EVENT
AI_MIN_CONFIDENCE=0.75
AI_MIN_REQUEST_INTERVAL=1.0

# Phase 10 — Natural-Language Intent Engine
INTENT_ENGINE_ENABLED=true
INTENT_PROVIDER=auto
INTENT_PROVIDER_TIMEOUT=5
INTENT_AUTO_EXECUTE_THRESHOLD=0.85
INTENT_CONFIRM_THRESHOLD=0.60
INTENT_CONFIRMATION_TIMEOUT=30
INTENT_LOG_RAW_INPUT=true
INTENT_CONSOLE_ENABLED=true
INTENT_API_ENABLED=false
INTENT_API_HOST=127.0.0.1
INTENT_API_PORT=8765
DEBUG_INTENT=true

# Phase 11 — Polished UI / HUD + System Visualization
HUD_ENABLED=true
HUD_MODE=STANDARD
HUD_THEME=DARK_CYAN
REDUCED_MOTION=false
HUD_SHOW_NOTIFICATIONS=true
HUD_SHOW_EVENT_STREAM=true
HUD_SHOW_PERFORMANCE=true
HUD_MAX_EVENTS=50
HUD_MAX_NOTIFICATIONS=5
HUD_MAX_COMMAND_HISTORY=10
HUD_NOTIFICATION_TIMEOUT_SEC=4.0

# Phase 12 — Final Hardening, Reliability, Security & Production
DEMO_MODE=false
HEALTH_CHECK_INTERVAL_SEC=5.0
MAX_EVENT_LOG_SIZE=200
MAX_COMMAND_HISTORY_SIZE=100
STRICT_INPUT_VALIDATION=true
