OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=10
OPENAI_ENABLED=true
AI_MODE=EVENT
AI_MIN_CONFIDENCE=0.75
AI_MIN_REQUEST_INTERVAL=1.0

# Phase 10 — Natural-Language Intent Engine
INTENT_ENGINE_ENABLED=true
INTENT_PROVIDER=auto
INTENT_PROVIDER_TIMEOUT=5
INTENT_AUTO_EXECUTE_THRESHOLD=0.85
INTENT_CONFIRM_THRESHOLD=0.60
INTENT_CONFIRMATION_TIMEOUT=30
INTENT_LOG_RAW_INPUT=true
INTENT_CONSOLE_ENABLED=true
INTENT_API_ENABLED=false
INTENT_API_HOST=127.0.0.1
INTENT_API_PORT=8765
DEBUG_INTENT=true
